# Public settings baked into the app at build time. None of these are secret,
# so this file is committed. See "Licensing & payments" in the README.

# Licence server URL (no trailing slash), shown after `npm run deploy` in licence-server/
VITE_LICENCE_API=

# Your Stripe Payment Link for Slate
VITE_BUY_URL=

# Public key printed by `npm run keys` in licence-server/ (keep the single quotes)
VITE_LICENCE_PUBLIC_KEY=
